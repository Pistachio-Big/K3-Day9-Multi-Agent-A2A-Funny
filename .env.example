# Sao chép file này thành `.env` rồi điền key. TUYỆT ĐỐI KHÔNG commit `.env`.
# Chọn 1 provider: groq | openrouter

LLM_PROVIDER=groq

# Nếu dùng Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Nếu dùng OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Tuỳ chọn: bật gọi LLM thật (1) hay chạy thuần deterministic (0).
# Scaffold chạy được cả khi = 0 (không cần key) để test pipeline.
USE_LLM=0
